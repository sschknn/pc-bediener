{
  "$schema": "https://opencode.ai/schema.json",
  "name": "pcbediener",
  "title": "PC-Bediener + FL Studio Addon",
  "version": "1.0.0",
  "description": "Autonome PC-Steuerung und FL Studio Produktion mit pcbediener MCP-Tools",
  "author": "Frank",
  "license": "MIT",
  "keywords": ["pcbediener", "flstudio", "producer", "dj", "automation", "mcp"],
  "main": "pcbediener_addon.py",
  "mcp": {
    "server": "pc-bediener",
    "transport": "stdio",
    "command": "python -m pcbediener serve"
  },
  "tools": {
    "safety_status": {"description": "Sicherheitsmodus anzeigen"},
    "safety_mode": {"description": "Sicherheitsmodus umschalten"},
    "exec_python": {"description": "Python-Code ausführen"},
    "exec_powershell": {"description": "PowerShell-Skript ausführen"},
    "exec_command": {"description": "Shell-Befehl ausführen"},
    "mouse_move": {"description": "Maus bewegen"},
    "mouse_click": {"description": "Maus klicken"},
    "mouse_drag": {"description": "Maus drag & drop"},
    "mouse_scroll": {"description": "Maus scrollen"},
    "keyboard_type": {"description": "Text tippen"},
    "keyboard_press": {"description": "Taste drücken"},
    "keyboard_hotkey": {"description": "Hotkey ausführen"},
    "clipboard_set": {"description": "Zwischenablage setzen"},
    "clipboard_get": {"description": "Zwischenablage lesen"},
    "sleep": {"description": "Warten"},
    "window_list": {"description": "Fenster auflisten"},
    "window_focus": {"description": "Fenster aktivieren"},
    "window_action": {"description": "Fensteraktion"},
    "window_modal_state": {"description": "Modal-Dialog prüfen"},
    "window_health": {"description": "Fenster-Gesundheit prüfen"},
    "window_activate": {"description": "Fenster in Vordergrund"},
    "window_list_controls": {"description": "UIA-Controls auflisten"},
    "window_set_text": {"description": "Text setzen"},
    "window_invoke": {"description": "Control invoke"},
    "window_menu": {"description": "Menüpunkt wählen"},
    "window_key_shortcut": {"description": "Tastenkombination senden"},
    "process_list": {"description": "Prozesse auflisten"},
    "process_info": {"description": "Prozess-Details"},
    "process_start": {"description": "Programm starten"},
    "process_kill": {"description": "Prozess beenden"},
    "screenshot": {"description": "Screenshot"},
    "screen_find_image": {"description": "Bild auf Screen finden"},
    "screen_wait_for_image": {"description": "Auf Bild warten"},
    "system_status": {"description": "Systemstatus"},
    "file_read": {"description": "Textdatei lesen"},
    "file_read_binary": {"description": "Binärdatei lesen"},
    "file_write": {"description": "Textdatei schreiben"},
    "file_list": {"description": "Ordnerinhalt auflisten"},
    "file_tree": {"description": "Baumansicht"},
    "file_search": {"description": "Rekursiv suchen"},
    "folder_create": {"description": "Ordner anlegen"},
    "file_move": {"description": "Verschieben/Umbenennen"},
    "file_copy": {"description": "Kopieren"},
    "file_delete": {"description": "Löschen"},
    "app_rules_list": {"description": "Programm-Gedächtnis Regeln"},
    "app_rule_get": {"description": "Bedienweg holen"},
    "app_rule_set": {"description": "Bedienweg speichern"},
    "app_rule_break": {"description": "Bedienweg als defekt markieren"},
    "flstudio_info": {"description": "FL Studio Wissen"}
  },
  "autoload": true,
  "session": {
    "prompt": "Du bist der PC-Bediener Producer DJ. Du steuerst den lokalen Windows-PC über pcbediener MCP-Tools und produzierst Tracks in FL Studio. Du bist voll autonom (safety_mode=auto). Bei jeder Aktion: prüfe zuerst safety_status(), führe dann aus, verifiziere das Ergebnis. FL Studio-Wissen ist in flstudio_info() hinterlegt. Arbeite mit Tastatur-Shortcuts vor Maus. Warte nach Programmstarts mit screen_wait_for_image() oder sleep(). Korrigiere Fehler selbst (stderr analysieren, Code anpassen, erneut ausführen)."
  }
}
